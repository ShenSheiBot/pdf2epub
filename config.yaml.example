title: Your Book Title Here
author: Author Name

# LLM credentials
anthropic_api_key: your-anthropic-api-key-here
anthropic_base_url: https://api.anthropic.com
anthropic_model: claude-sonnet-4-20250514
google_api_key: your-google-api-key-here
openai_api_key: your-openai-api-key-here
openai_base_url: https://api.openai.com/v1
openai_model: gpt-4o

# Translation config
target_language: English  # Target language for translation
source_language: Japanese  # Source language

# Sync config
s3_access_key_id: your-s3-access-key
s3_secret_access_key: your-s3-secret-key
s3_bucket_name: your-bucket-name
s3_endpoint: https://s3.amazonaws.com  # Or your S3-compatible endpoint

num_retries: 3
max_backoff_seconds: 30
max_concurrent_workers: 8  # Maximum number of concurrent API calls (adjust based on your API rate limits)

# Japanese Vertical OCR Backend Selection
jp_ocr_backend: azure  # Options: 'azure' or 'vision'

azure_endpoint: https://your-azure-endpoint.cognitiveservices.azure.com/
azure_key: your-azure-key-here

# Vision API OCR Configuration
service_account_key_path: sa-keys.json  # Path to Google Cloud service account key file
vision_ocr_settings:
  zoom_factor: 1.0  # Image extraction quality (1.0-3.0, higher = better quality but slower)
  max_workers: 4  # Number of parallel processing threads

  # Illustration detection settings
  illustration_padding: 25  # Pixels to pad around text regions when whiting out
  trim_step_percent: 0.005  # Step size for border trimming (0.005-0.1)
  min_black_pixels: 200  # Minimum non-white pixels to consider as content

# Model retry configuration
# ========================
# NEW: You can now specify separate retry counts for API errors vs validation failures
#
# api_retries: Number of times to retry on transient API errors (network, rate limits)
# validation_retries: Number of times to retry the same model when output fails validation
# max_retries: (Legacy) Used for api_retries if new fields aren't specified
#
# Models are tried in order until one succeeds

polish_models:
  - provider: anthropic
    model: claude-sonnet-4-20250514
    api_retries: 2          # Retry API/network errors twice
    validation_retries: 1   # Retry once if output fails validation
    # Or use legacy format:
    # max_retries: 2        # Backward compatible - sets api_retries=2, validation_retries=0

translation_models:
  - provider: openai
    model: deepseek-chat
    api_retries: 3          # More tolerant of API errors
    validation_retries: 0   # Don't retry validation failures (faster)
  # Example with fallback model:
  # - provider: anthropic
  #   model: claude-sonnet-4-20250514
  #   api_retries: 2
  #   validation_retries: 1

# Validation strategy configuration
# ==================================
# Controls how validation failures are handled across all processors
validation_strategy:
  max_attempts: 2                  # Global max validation attempts per file
  use_longest_on_failure: false    # If true, use longest response when all attempts fail
  fallback_between_models: true    # If true, try next model when current fails validation

