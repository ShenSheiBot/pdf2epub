#!/usr/bin/env python3
"""Run a command with the private Chandra Cloudflare Access token."""

from __future__ import annotations

import argparse
import json
import os
import stat
import sys
from pathlib import Path


def _load_credentials(path: Path) -> tuple[str, str]:
    try:
        file_stat = path.stat()
    except OSError as exc:
        raise SystemExit(f"Cannot read Chandra Access credentials: {path}: {exc}")

    if not stat.S_ISREG(file_stat.st_mode):
        raise SystemExit(f"Chandra Access credentials are not a regular file: {path}")
    if file_stat.st_mode & 0o077:
        raise SystemExit(
            f"Chandra Access credentials must not be accessible by group/others: {path}"
        )

    try:
        payload = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, UnicodeError, json.JSONDecodeError) as exc:
        raise SystemExit(f"Invalid Chandra Access credentials: {path}: {exc}")

    client_id = payload.get("client_id")
    client_secret = payload.get("client_secret")
    if not isinstance(client_id, str) or not client_id:
        raise SystemExit(f"Chandra Access credentials have no client_id: {path}")
    if not isinstance(client_secret, str) or not client_secret:
        raise SystemExit(f"Chandra Access credentials have no client_secret: {path}")
    return client_id, client_secret


def main() -> None:
    parser = argparse.ArgumentParser(
        description="Inject Chandra Cloudflare Access credentials into one child command."
    )
    parser.add_argument(
        "--credentials",
        type=Path,
        default=Path(
            os.environ.get(
                "CHANDRA_ACCESS_CREDENTIALS",
                "~/.config/pdf2epub/chandra-access.json",
            )
        ).expanduser(),
        help=(
            "credential JSON path (default: ~/.config/pdf2epub/chandra-access.json; "
            "or CHANDRA_ACCESS_CREDENTIALS)"
        ),
    )
    parser.add_argument("command", nargs=argparse.REMAINDER)
    args = parser.parse_args()

    command = args.command
    if command[:1] == ["--"]:
        command = command[1:]
    if not command:
        parser.error("a command is required")

    client_id, client_secret = _load_credentials(args.credentials.expanduser())
    child_env = os.environ.copy()
    child_env["CHANDRA_CF_ACCESS_CLIENT_ID"] = client_id
    child_env["CHANDRA_CF_ACCESS_CLIENT_SECRET"] = client_secret

    try:
        os.execvpe(command[0], command, child_env)
    except FileNotFoundError:
        raise SystemExit(f"Command not found: {command[0]}") from None


if __name__ == "__main__":
    main()
